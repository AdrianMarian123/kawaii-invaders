# ───────────────────────────────────────────────────────────────────────────
#  Configurarea monetizării.  Copiază acest fișier în `.env` și pune acolo
#  valorile tale reale.  `.env` e gitignorat; acesta (`.env.example`) nu.
#
#  ATENȚIE — ce e aici NU e secret.  Vite inline-uiește orice variabilă
#  `VITE_*` direct în bundle, deci valorile ajung în dist/ și în APK, unde
#  oricine le poate citi.  E în regulă: ID-urile AdMob și ID-urile de produs
#  sunt publice prin design.  Dar NU pune aici niciodată chei de service
#  account Google Play sau orice altceva care trebuie să rămână secret —
#  acelea stau doar pe server (variabile de environment pe Render).
#
#  După ce schimbi ceva aici, rulează `npm run sync:android` ca App ID-ul să
#  ajungă și în AndroidManifest.xml (JS-ul nu poate scrie singur în manifest).
# ───────────────────────────────────────────────────────────────────────────

# ——— AdMob ———
# Valorile implicite de mai jos sunt ID-urile OFICIALE DE TEST ale Google.
# Sunt sigure în dezvoltare și întorc mereu o reclamă.  Înlocuiește-le cu ale
# tale abia la build-ul de release — niciodată nu testa pe ID-urile reale, e
# fraudă de clicuri și îți poate suspenda contul AdMob.
VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# true = cere reclame de test chiar și cu ID-urile reale puse mai sus.
# Pune-l pe false DOAR în build-ul care pleacă în Play Store.
VITE_ADMOB_TESTING=true

# Pauza minimă între două reclame, în secunde.  0 = la fiecare meci, exact cum
# ai cerut.  E aici ca supapă: dacă ratingul scade sau Play îți semnalează
# reclame prea dese, urci valoarea fără să umbli în cod.
VITE_ADS_MIN_INTERVAL_S=0

# ——— RevenueCat (Billing) ———
# Cheia PUBLICA de SDK pentru Android, din RevenueCat → Project settings → API
# keys. Incepe cu "goog_". E publica prin design (e menita sa stea in client),
# dar sta aici ca sa poti comuta intre proiectul de test si cel real fara sa
# umbli in cod. NU pune aici cheia secreta (sk_...) si nici service account-ul
# Google Play — acelea stau doar pe server.
# Lasa-o goala si cumparaturile sunt pur si simplu dezactivate.
VITE_REVENUECAT_API_KEY=

# ——— Unelte de dezvoltare ———
# God mode (tastezi „god" in joc = invincibil; „n" sare peste val). Exista DOAR
# cand asta e true: in build-ul de release codul nu raspunde la nicio tasta.
# Lasa-l pe false pentru orice build care pleaca spre jucatori.
VITE_DEV_TOOLS=false
